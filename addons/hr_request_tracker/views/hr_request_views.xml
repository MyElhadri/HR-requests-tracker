<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hr_request_form" model="ir.ui.view">
        <field name="name">hr.request.form</field>
        <field name="model">hr.request</field>
        <field name="arch" type="xml">
            <form string="HR Request">
                <header>
                    <button name="action_submit" string="Submit" type="object" class="oe_highlight" invisible="state != 'draft'" data-hotkey="v"/>
                    <button name="action_start_processing" string="Start Processing" type="object" class="oe_highlight" invisible="state != 'submitted'" groups="hr_request_tracker.group_hr_request_manager"/>
                    <button name="action_mark_done" string="Mark Done" type="object" class="oe_highlight" invisible="state != 'in_progress'" groups="hr_request_tracker.group_hr_request_manager"/>
                    <button name="action_reset_draft" string="Reset to Draft" type="object" invisible="state == 'draft'" groups="hr_request_tracker.group_hr_request_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                        <h2>
                            <field name="title" placeholder="Request Title..." readonly="state != 'draft'"/>
                        </h2>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id" readonly="state != 'draft'"/>
                            <field name="request_type" readonly="state != 'draft'"/>
                            <field name="priority" widget="priority" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="request_date"/>
                            <field name="responsible_id" readonly="state != 'draft'"/>
                            <field name="done_date" invisible="state != 'done'"/>
                            <field name="processing_duration" invisible="state != 'done'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description" placeholder="Describe your request..." readonly="state != 'draft'"/>
                        </page>
                        <page string="HR Response" name="hr_response">
                            <field name="hr_response" placeholder="Response from HR..." readonly="state == 'done'" groups="hr_request_tracker.group_hr_request_manager"/>
                            <field name="hr_response" readonly="1" groups="!hr_request_tracker.group_hr_request_manager"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_hr_request_tree" model="ir.ui.view">
        <field name="name">hr.request.tree</field>
        <field name="model">hr.request</field>
        <field name="arch" type="xml">
            <tree string="HR Requests" decoration-info="state == 'draft'" decoration-warning="state == 'in_progress'" decoration-success="state == 'done'">
                <field name="name"/>
                <field name="title"/>
                <field name="employee_id"/>
                <field name="request_type"/>
                <field name="request_date"/>
                <field name="priority" widget="priority" optional="show"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'in_progress'" decoration-success="state == 'done'"/>
            </tree>
        </field>
    </record>

    <record id="view_hr_request_search" model="ir.ui.view">
        <field name="name">hr.request.search</field>
        <field name="model">hr.request</field>
        <field name="arch" type="xml">
            <search string="Search HR Requests">
                <field name="name"/>
                <field name="title"/>
                <field name="employee_id"/>
                <separator/>
                <filter string="My Requests" name="my_requests" domain="[('create_uid', '=', uid)]"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Submitted" name="submitted" domain="[('state', '=', 'submitted')]"/>
                <filter string="In Progress" name="in_progress" domain="[('state', '=', 'in_progress')]"/>
                <filter string="Done" name="done" domain="[('state', '=', 'done')]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="Employee" name="group_by_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Request Type" name="group_by_type" context="{'group_by': 'request_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hr_request" model="ir.actions.act_window">
        <field name="name">HR Requests</field>
        <field name="res_model">hr.request</field>
        <field name="view_mode">tree,kanban,form</field> <field name="context">{'search_default_my_requests': 1}</field>
        <field name="help" type="html">
          <p class="o_view_nocontent_smiling_face">
            Create your first HR Request!
          </p>
          <p>
            Track all your HR-related inquiries, documents requests, and certificates.
          </p>
        </field>
    </record>

</odoo>