<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_request_kanban" model="ir.ui.view">
        <field name="name">hr.request.kanban</field>
        <field name="model">hr.request</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column" quick_create="false">
                <field name="id"/> <!-- Obligatoire pour certains widgets comme many2one_avatar_employee -->
                <field name="name"/>
                <field name="title"/>
                <field name="employee_id"/>
                <field name="state"/>
                <field name="priority"/>
                <field name="request_date"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click oe_kanban_card">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="title"/>
                                        </strong>
                                        <small class="o_kanban_record_subtitle text-muted">
                                            <field name="name"/>
                                        </small>
                                    </div>
                                    <div class="o_kanban_record_top_right">
                                        <field name="priority" widget="priority"/>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body">
                                    <div>
                                        <i class="fa fa-user" role="img" aria-label="Employee" title="Employee"></i>
                                        <field name="employee_id"/>
                                    </div>
                                    <div>
                                        <i class="fa fa-calendar" role="img" aria-label="Date" title="Date"></i>
                                        <field name="request_date"/>
                                    </div>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="activity_ids" widget="kanban_activity"/>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <field name="employee_id" widget="many2one_avatar_employee"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
</odoo>
