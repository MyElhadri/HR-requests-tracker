<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.module.category" id="module_category_hr_request">
            <field name="name">HR Request Tracker</field>
            <field name="description">Helps you manage HR requests.</field>
            <field name="sequence">20</field>
        </record>

        <record id="group_hr_request_employee" model="res.groups">
            <field name="name">Employee (User)</field>
            <field name="category_id" ref="module_category_hr_request"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_hr_request_manager" model="res.groups">
            <field name="name">HR Manager</field>
            <field name="category_id" ref="module_category_hr_request"/>
            <field name="implied_ids" eval="[(4, ref('group_hr_request_employee'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
    </data>
    
    <data noupdate="1">
        <!-- Rule for Employees: See only their own requests -->
        <record id="hr_request_employee_rule" model="ir.rule">
            <field name="name">HR Request: Employee sees only their own</field>
            <field name="model_id" ref="model_hr_request"/>
            <field name="domain_force">['|', ('create_uid', '=', user.id), ('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_hr_request_employee'))]"/>
        </record>

        <!-- Rule for HR Managers: See all requests -->
        <record id="hr_request_manager_rule" model="ir.rule">
            <field name="name">HR Request: Manager sees all</field>
            <field name="model_id" ref="model_hr_request"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_hr_request_manager'))]"/>
        </record>
    </data>
</odoo>
